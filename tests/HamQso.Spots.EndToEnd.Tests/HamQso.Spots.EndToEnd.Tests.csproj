<Project Sdk="Microsoft.NET.Sdk">
  <!--
    End-to-end tests against the deployed server (spot.hamqso.app) and Supabase.
    Not in HamQso.Spots.slnx: they need production keys. Run them by hand:
      SUPABASE_PUBLISHABLE_KEY=... SUPABASE_SECRET_KEY=... dotnet test tests/HamQso.Spots.EndToEnd.Tests
    SendSpotTests and ProxyTests run the server here (real Supabase, fake DX node
    and fake services on loopback): never the real cluster or the real services.
  -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="MQTTnet" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/HamQso.Spots.Host/HamQso.Spots.Host.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="../HamQso.Spots.Infrastructure.Tests/Sending/FakeDxNode.cs" Link="FakeDxNode.cs" />
    <Compile Include="../HamQso.Spots.Host.Tests/FakeUpstream.cs" Link="FakeUpstream.cs" />
  </ItemGroup>
</Project>
